#!/bin/bash
set -e

# On upgrade ($1 = "upgrade"): stop the service and remember whether it was
# running, but leave it ENABLED -- the new postinst restarts it (legacy mode)
# or sets it by role (role mode). Before 4.0 this also disabled the service on
# every upgrade and relied on postinst to re-enable it.
# On remove/purge: stop, disable, and remove the nftables table.
mkdir -p /var/lib/bad_ips

if systemctl is-enabled --quiet bad_ips.service 2>/dev/null; then
    touch /var/lib/bad_ips/.upgrade_was_enabled
fi

if systemctl is-active --quiet bad_ips.service; then
    touch /var/lib/bad_ips/.upgrade_was_active
    systemctl stop bad_ips.service
    echo "Stopped bad_ips.service"
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if systemctl is-enabled --quiet bad_ips.service 2>/dev/null; then
        systemctl disable bad_ips.service
        echo "Disabled bad_ips.service"
    fi

    # Remove Bad IPs nftables configuration and its live table. Deleting
    # just our table leaves the rest of the host firewall untouched (a
    # "systemctl reload nftables" would also drop any runtime-added rules).
    rm -f /etc/nftables.d/99-badips.nft
    if nft list table inet badips >/dev/null 2>&1; then
        nft delete table inet badips || true
        echo "Removed Bad IPs nftables table (inet badips)"
    fi

    # IMPORTANT: We intentionally leave the /etc/nftables.d/ directory and
    # the include statement in /etc/nftables.conf in place, as they may be
    # used by other packages.
fi

exit 0
