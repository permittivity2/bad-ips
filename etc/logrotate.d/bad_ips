/var/log/bad_ips/bad_ips.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    # copytruncate keeps the file (and its owner, the unprivileged service
    # user) in place; the daemon appends via O_APPEND so no reopen/reload
    # is needed. "create 0640 root root" left the service unable to write.
    copytruncate
}
